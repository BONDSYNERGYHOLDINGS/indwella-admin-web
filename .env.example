# --- Browser-facing API base (same-origin, proxied by next.config.js) ---
# The admin console authenticates by an httpOnly cookie, so API calls MUST be
# same-origin for the cookie to be sent (see ADMIN_AUTH.md). Leave this as
# `/api`; the Next rewrite forwards /api/* to API_PROXY_TARGET server-side.
# The SDK appends route paths (e.g. `/admin/...`) directly to this value, so
# calls become `/api/admin/...` in the browser.
NEXT_PUBLIC_API_BASE_URL=/api

# --- Server-side proxy target (never exposed to the browser) ---
# The real FastAPI backend base URL (no trailing slash). next.config.js
# rewrites /api/* to `${API_PROXY_TARGET}/*`.
API_PROXY_TARGET=https://indwella-server.onrender.com
